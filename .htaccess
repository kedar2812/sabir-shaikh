Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Every canonical URL uses www, so send the bare domain there, keeping the scheme.
  # Once the SSL certificate is active, replace both rules with one https:// redirect.
  RewriteCond %{HTTP_HOST} ^sabirshaikh\.in$ [NC]
  RewriteCond %{HTTPS} on
  RewriteRule ^ https://www.sabirshaikh.in%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^sabirshaikh\.in$ [NC]
  RewriteRule ^ http://www.sabirshaikh.in%{REQUEST_URI} [R=301,L]
</IfModule>

AddType image/webp .webp
AddType font/woff2 .woff2
AddType image/svg+xml .svg

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
